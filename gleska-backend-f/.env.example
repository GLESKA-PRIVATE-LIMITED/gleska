# Backend environment variables. Copy this file to .env and fill in local values.

ENVIRONMENT=development

DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://goleska.in,https://www.goleska.in
API_V1_PREFIX=/api/v1

JWT_SECRET_KEY=replace-with-a-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Employer verification provider. Leave blank until a real provider contract
# and credentials are supplied. Never expose these values to the frontend.
EMPLOYER_VERIFICATION_PROVIDER=cashfree
EMPLOYER_VERIFICATION_API_BASE_URL=https://sandbox.cashfree.com/verification
EMPLOYER_VERIFICATION_API_KEY=
EMPLOYER_VERIFICATION_API_SECRET=
EMPLOYER_VERIFICATION_ENVIRONMENT=sandbox
# Production: https://api.cashfree.com/verification
EMPLOYER_VERIFICATION_TIMEOUT_SECONDS=15
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_SECURE_ID_PUBLIC_KEY=<your public PEM key>
CASHFREE_ENV=SANDBOX
CASHFREE_API_VERSION=2022-09-01
CASHFREE_PG_CLIENT_ID=
CASHFREE_PG_CLIENT_SECRET=
CASHFREE_PG_API_VERSION=2023-08-01
CASHFREE_PAYMENT_TIMEOUT_SECONDS=15
WEBHOOK_URL=https://your-public-backend.example.com
# Name printed on AI-credit purchase receipts.
BILLING_SELLER_NAME=GLESKA PRIVATE LIMITED
# Registered industry always requires CIN. GSTIN is optional and is checked only when entered.
EMPLOYER_REQUIRED_VERIFICATIONS=REGISTERED_INDUSTRY:CIN;UNREGISTERED_BUSINESS:AADHAAR

MSG91_WIDGET_ID=your-msg91-widget-id
MSG91_WIDGET_TOKEN=your-msg91-widget-token
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_ACCESS_TOKEN_VERIFY_URL=https://api.msg91.com/api/v5/widget/verifyAccessToken
MSG91_TIMEOUT_SECONDS=15
MSG91_OTP_LENGTH=6
# WhatsApp Business sender number registered in MSG91 (country code, digits only) — used by the
# Hiring agent send_whatsapp tool. Not the OTP widget id.
MSG91_WHATSAPP_NUMBER=91XXXXXXXXXX
PASSWORD_RESET_OTP_TTL_SECONDS=600
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=30
PASSWORD_RESET_AUTH_TTL_SECONDS=600

# Gemini structured job-requirement extraction. Keep the key server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
# Financial invoice scan provider request timeout.
FINANCIAL_SCAN_GEMINI_TIMEOUT_SECONDS=120

# Google Maps Routes API for actual road routing. Keep the key server-side.
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_TIMEOUT_SECONDS=15
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=GLESKA/1.0 (contact: admin@goleska.in)
NOMINATIM_TIMEOUT_SECONDS=10

# Contact inquiry / Email notification configuration (Resend)
CONTACT_RECIPIENT_EMAIL=samikshalone2@gmail.com
EMAIL_PROVIDER=resend
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=GO LESKA
EMAIL_TIMEOUT_SECONDS=15

CASHFREE_SECURE_ID_PUBLIC_KEY=<your public key>
CASHFREE_SECURE_ID_PUBLIC_KEY_PASSWORD=<your password>


# How to get: Install TallyPrime on a Windows machine → F1 → Settings → Connectivity → enable ODBC/XML Server on port 9000. Only works when Tally is running on the same network as your backend.
TALLY_API_URL=http://localhost:9000


# OAuth callback base URL (your backend's public URL)
OAUTH_CALLBACK_BASE_URL=http://localhost:8000
# Fernet key that encrypts connector OAuth tokens at rest. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never rotate without re-encrypting: rows encrypted with a lost key force users to reconnect.
CONNECTOR_TOKEN_ENCRYPTION_KEY=

# Google — one client covers Calendar, Drive, Docs, Sheets, Forms, Gmail
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Slack
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=

# Zoom
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=

# LinkedIn
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=

# Facebook — covers Facebook + Instagram
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=

# Microsoft — covers Outlook + Microsoft 365
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
