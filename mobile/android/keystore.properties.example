# Copy to mobile/android/keystore.properties (untracked) and fill in the upload key details.
# Never commit the real file, the keystore, or these passwords.
# GLESKA_UPLOAD_* environment variables take precedence over values in this file.

# Path to the upload keystore. Relative paths resolve against mobile/android/app;
# an absolute path outside the repository is recommended.
storeFile=/secure/path/to/upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
