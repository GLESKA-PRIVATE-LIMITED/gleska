NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
NEXT_PUBLIC_MSG91_WIDGET_ID=your-msg91-widget-id
NEXT_PUBLIC_MSG91_TOKEN=your-msg91-token
